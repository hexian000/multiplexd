#ifndef CONFIG_H
#define CONFIG_H

const char *multiplexd_version(void);

#define PROJECT_NAME "multiplexd"
#define PROJECT_VER (multiplexd_version())
#define PROJECT_HOMEPAGE "@PROJECT_HOMEPAGE_URL@"

#cmakedefine01 WITH_REUSEPORT
#cmakedefine01 WITH_TCP_FASTOPEN
#cmakedefine01 WITH_TCP_NOTSENT_LOWAT
#cmakedefine01 WITH_TCP_USER_TIMEOUT
#cmakedefine01 WITH_TLS
#cmakedefine01 WITH_THREADS

#endif /* CONFIG_H */
